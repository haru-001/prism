# 复制成 .env.local 用于本地开发；部署到 Vercel 时在项目的 Environment Variables 里填写

# 必填：用来加密上游 Key 和签发登录凭证的密钥，随便一串 32 位以上的随机字符
# 生成方法：openssl rand -base64 32
# 部署后不要再改，改了之后已保存的上游 Key 就解不开了，需要重新填
PRISM_SECRET=
# 首次设访问密码时要填的「初始化口令」，防止站点刚上线时被别人抢先设密码。不设就用 PRISM_SECRET
# PRISM_SETUP_CODE=
# 服务端下载图片默认拦截内网地址。上游中转在内网、返回内网图片地址时，在这里写放行的 host:port（逗号分隔）
# PRISM_ALLOW_PRIVATE_IMAGE_FETCH=

# 可选：访问密码。设了它，首次引导会跳过「设访问密码」这一步，密码也只能在这里改
ACCESS_PASSWORD=

# 可选：一个固定的接口令牌，和页面上生成的令牌同时有效，重置页面令牌不影响它
PRISM_API_TOKEN=

# 线上必填：Aiven 免费 MySQL 的 Service URI（Aiven 控制台 → 服务 → Overview → Connection information）
# 形如 mysql://avnadmin:密码@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# 本地不填时数据存在 .data/kv.json
DATABASE_URL=

# 强烈建议：Aiven 的 CA 证书（同一页的 CA certificate），整段粘贴，包括 BEGIN / END 两行；也可以填它的 base64
# 填了才会校验数据库证书；不填时连接仍加密，但不校验对方身份
DATABASE_CA_CERT=
# 本地开发也可以直接指向下载的文件：
# DATABASE_CA_FILE=./ca.pem

# 可选：每个函数实例最多几条数据库连接（默认 3，免费 MySQL 总共 76 条）
# DB_POOL_SIZE=3

# 可选：Vercel Blob，用来存生成的图片和上传的图片（在 Vercel 的 Storage 里接 Blob 会自动填好）
# 不填时图片压缩后存进 MySQL：超过 200KB 的转成 WebP，单张目标不超过 DB_IMAGE_MAX_KB，
# 总量超过 DB_IMAGES_MAX_MB 时自动删掉最早的图
BLOB_READ_WRITE_TOKEN=
# DB_IMAGE_MAX_KB=800
# DB_IMAGES_MAX_MB=300

# 可选：用量统计按哪个时区分天（默认 Asia/Shanghai）
# PRISM_TZ=Asia/Shanghai

# 可选：每个函数实例在内存里缓存渠道、设置等数据的秒数（默认 30，填 0 每次都读库）
# PRISM_CACHE_TTL=30

# 可选：数据库总额度（MB，默认 1024，即 Aiven 免费档的 1GB），用来算设置页「数据库容量」的占比
# DB_QUOTA_MB=1024
# 可选：已用空间超过百分之多少时棱音在顶部提醒（默认 80，1~99）
# DB_WARN_PERCENT=80

# 只在迁移旧数据时用（npm run migrate），网站本身不再需要：
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
